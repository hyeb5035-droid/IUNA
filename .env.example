NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_. Required for the login API route.
# Obtain from: Supabase Dashboard → Project Settings → API → service_role (secret)
# Local: add the value to .env.local
# Cloudflare: add via `wrangler secret put SUPABASE_SERVICE_ROLE_KEY`
SUPABASE_SERVICE_ROLE_KEY=
